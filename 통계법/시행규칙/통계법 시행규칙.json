  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규칙은 통계법(이하 \"법\"이라 한다) 및 동법시행령(이하 \"영\"이라 한다)의 시행에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "지정통계의 지정신청",
        "chapter": "",
        "content": "제2조 (지정통계의 지정신청) 통계작성기관의 장이 지정통계의 지정을 받고자 할 때에는 별지 제1호서식의 지정신청서를 경제기획원장관에게 제출하여야 한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "통계작성의 승인신청",
        "chapter": "",
        "content": "제3조 (통계작성의 승인신청) 통계작성기관의 장이 법 제3조제1항 및 영 제5조제1항의 규정에 의하여 통계작성에 관한 승인을 얻고자 할 때에는 당해통계자료에 관한 조사실시 예정일(보고통계에 있어서는 당해통계자료에 관한 보고요구 예정일. 이하 같다) 30일전까지 별지 제2호서식의 승인신청서를 경제기획원장관에 제출하여야 한다. 다만, 부득이한 사유로 30일전까지 승인신청을 할 수 없을 때에는 그 사유서를 첨부하여 당해통계자료에 관한 조사실시예정일 7일전까지 승인신청을 할 수 있다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "통계작성의 중지등의 승인신청",
        "chapter": "",
        "content": "제4조 (통계작성의 중지등의 승인신청) 통계작성기관의 장이 법 제3조제1항 후단의 규정에 의하여 통계작성의 중지 또는 변경에 관한 승인을 얻고자 할 때에는 그 신청서에 사유서를 첨부하여 경제기획원장관에게 제출하여야 한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "통계작성의 실시등에 관한 통보",
        "chapter": "",
        "content": "제5조 (통계작성의 실시등에 관한 통보) 법 제3조제2항의 규정에 의하여 경제기획원장관으로부터 통계작성의 실시ㆍ중지ㆍ변경 또는 통계작성사무 개선의 요구를 받은 자는 그 처리결과를 경제기획원장관에게 통보하여야 한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "증표",
        "chapter": "",
        "content": "제6조 (증표) 법 제7조제2항의 규정에 의한 증표는 별지 제3호서식에 의한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "통계간행물 발간승인신청서의 기재사항",
        "chapter": "",
        "content": "제7조 (통계간행물 발간승인신청서의 기재사항) 영 제10조제3항의 규정에 의한 통계간행물의 발간승인신청서에는 당해간행물의 발간예정일ㆍ발행부수 및 통계자료의 근거를 기재하여야 한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "독촉장",
        "chapter": "",
        "content": "제8조 (독촉장) 영 제12조의 규정에 의한 독촉장은 별지 제4호서식에 의한다.",
        "enforcement_date": "19760721",
        "relations": [],
        "images": [],
        "provision_id": "law:통계법시행규칙#JO0008"
      }
    ]
