      },
      {
        "article_no": "제20조",
        "article_title": "국가통계승인（협의）마크",
        "chapter": "",
        "content": "제20조(국가통계승인（협의）마크) 영 제32조에 따른 국가통계승인(협의)마크는 별표 2와 같다.",
        "enforcement_date": "20180221",
        "relations": [],
        "images": [],
