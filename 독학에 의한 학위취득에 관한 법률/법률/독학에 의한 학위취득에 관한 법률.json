    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 법은 독학자에게 학사학위(이하 \"學位\"라 한다)취득의 기회를 부여함으로써 평생교육의 이념을 구현하고 개인의 자아실현과 국가사회의 발전에 기여함을 목적으로 한다.",
        "enforcement_date": "20040120",
        "relations": [],
        "images": [],
        "provision_id": "law:독학에의한학위취득에관한법률#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "국가의 임무",
        "chapter": "",
        "content": "제2조 (국가의 임무) 국가는 독학자가 학위를 취득하는데 필요한 편의를 제공하여야 한다.",
        "enforcement_date": "20040120",
        "relations": [],
        "images": [],
        "provision_id": "law:독학에의한학위취득에관한법률#JO0002"
