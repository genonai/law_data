  "body": {
    "format": "articles",
    "article_count": 25,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "임무",
        "chapter": "",
        "content": "제1조 (임무) 육군본부는 육군의 정책ㆍ편제ㆍ교육훈련ㆍ인사ㆍ군수ㆍ동원 및 작전지원 기타 육군의 운영에 관한 사항을 관장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "참모부서",
        "chapter": "",
        "content": "제2조 (참모부서)\n①육군본부에 일반참모부와 특별참모부를 둔다.\n②일반참모부는 기획관리참모부ㆍ인사참모부ㆍ정보작전참모부ㆍ군수참모부 및 동원참모부로 하고, 각 참모부에는 참모부장과 차장 각 1인을 둔다.\n③특별참모부는 법무감실ㆍ감찰감실ㆍ인사운영감실ㆍ헌병감실ㆍ의무감실ㆍ부관감실ㆍ군종감실ㆍ정훈감실ㆍ화학감실ㆍ항공감실ㆍ통신감실ㆍ공병감실ㆍ군사연구실과 본부사령실로 하고, 각 감실에는 감과 차감 각 1인을 두며, 군사연구실에는 실장을, 본부사령실에는 본부사령을 둔다.\n④제2항 및 제3항의 각 참모부장ㆍ차장ㆍ감ㆍ군사연구실장 및 본부 사령은 육군의 장관급장교로, 차감은 육군의 장관급장교 또는 영관급장교로 보한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "비서관",
        "chapter": "",
        "content": "제3조 (비서관)\n①육군본부에 비서관을 두며, 비서관은 육군장관급장교 또는 영관급장교로 보한다.\n②비서관은 참모총장과 참모차장의 행정ㆍ의전ㆍ공보업무 및 일반참모활동의 조정ㆍ협조를 필요로 하는 사항에 대한 지원에 관하여 보좌한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "기획관리참모부장",
        "chapter": "",
        "content": "제4조 (기획관리참모부장) 기획관리참모부장은 육군의 정책ㆍ중기계획ㆍ군사력건설 소요제기의 지원ㆍ예산ㆍ회계ㆍ전산 및 체계분석등 기획관리업무에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "인사참모부장",
        "chapter": "",
        "content": "제5조 (인사참모부장) 인사참모부장은 군인ㆍ군무원에 대한 인력관리ㆍ인사관리ㆍ인사근무등 인사에 관한 사항을 분장하며, 참모총장이 지정하는 특별참모를 조정ㆍ통제 및 감독한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "정보작전참모부장",
        "chapter": "",
        "content": "제6조 (정보작전참모부장) 정보작전참모부장은 정보작전상황 유지전파ㆍ작전지원ㆍ편제ㆍ교육훈련ㆍ전투발전ㆍ군사보안ㆍ대외정보 교류 및 기타 정보작전에 관한 사항을 분장하고, 참모총장이 지정하는 특별참모를 조정ㆍ통제 및 감독한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "군수참모부장",
        "chapter": "",
        "content": "제7조 (군수참모부장) 군수참모부장은 군수지원계획의 수립, 군수물자의 조달ㆍ보급ㆍ정비ㆍ수송, 전력증강사업의 집행ㆍ감독 및 기타 군수업무에 관한 사항을 분장하고, 참모총장이 지정하는 특별참모를 조정ㆍ통제 및 감독한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "동원참모부장",
        "chapter": "",
        "content": "제8조 (동원참모부장) 동원참모부장은 육군의 동원ㆍ예비군업무에 관한 정책 및 계획의 수립과 그 집행의 감독에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "법무감",
        "chapter": "",
        "content": "제9조 (법무감) 법무감은 군사법의 운영ㆍ군의 형정ㆍ법규관리ㆍ소송ㆍ배상ㆍ계약안 및 조약안의 검토 기타 법무업무에 관하여 참모총장을 보좌한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "감찰감",
        "chapter": "",
        "content": "제10조 (감찰감) 감찰감은 군사검열, 특명사항의 조사, 회계감사, 진정사건의 처리등 감찰업무에 관하여 참모총장을 보좌한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "인사운영감",
        "chapter": "",
        "content": "제11조 (인사운영감) 인사운영감은 군인ㆍ군무원 및 전시동원근로자에 대한 인사운영에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "헌병감",
        "chapter": "",
        "content": "제12조 (헌병감) 헌병감은 군풍기 유지ㆍ범죄예방ㆍ범죄수사 및 요인경호등 군사경찰에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "의무감",
        "chapter": "",
        "content": "제13조 (의무감) 의무감은 군인ㆍ군무원의 보건ㆍ진료ㆍ환자수송ㆍ방역ㆍ약무등 의무에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "부관감",
        "chapter": "",
        "content": "제14조 (부관감) 부관감은 군인ㆍ군무원의 인사처리ㆍ병적의 기록유지ㆍ문서ㆍ행정ㆍ군사우편ㆍ인쇄ㆍ행사 기타 서무에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0014"
      },
      {
        "article_no": "제15조",
        "article_title": "군종감",
        "chapter": "",
        "content": "제15조 (군종감) 군종감은 군인ㆍ군무원의 신앙활동ㆍ인격지도ㆍ선도활동 기타 종교에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "정훈감",
        "chapter": "",
        "content": "제16조 (정훈감) 정훈감은 군인ㆍ군무원의 국가관 확립ㆍ정신전력ㆍ정서순화등 정훈에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0016"
      },
      {
        "article_no": "제17조",
        "article_title": "화학감",
        "chapter": "",
        "content": "제17조 (화학감) 화학감은 화학에 관한 계획, 화생방 전술의 연구ㆍ발전 기타 화학에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0017"
      },
      {
        "article_no": "제18조",
        "article_title": "항공감",
        "chapter": "",
        "content": "제18조 (항공감) 항공감은 육군의 항공에 관한 계획, 항공전술의 연구ㆍ발전, 항공안전업무 기타 항공에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0018"
      },
      {
        "article_no": "제19조",
        "article_title": "통신감",
        "chapter": "",
        "content": "제19조 (통신감) 통신감은 통신전자에 관한 사업계획의 집행, 통신전자체계의 연구ㆍ발전 기타 통신전자에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0019"
      },
      {
        "article_no": "제20조",
        "article_title": "공병감",
        "chapter": "",
        "content": "제20조 (공병감) 공병감은 공병에 관한 계획, 공병전술의 연구ㆍ발전, 군용 부동산의 관리 기타 공병에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0020"
      },
      {
        "article_no": "제21조",
        "article_title": "군사연구실장",
        "chapter": "",
        "content": "제21조 (군사연구실장) 군사연구실장은 육군의 군사연구업무에 관한 계획수립과 군사 및 전사편찬에 관한 사항을 분장한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0021"
      },
      {
        "article_no": "제22조",
        "article_title": "본부사령",
        "chapter": "",
        "content": "제22조 (본부사령)\n①본부사령은 육군본부의 경비ㆍ시설관리ㆍ보급ㆍ장비정비와 육군본부 소속 사병의 내무생활 및 군풍기에 관한 사항을 분장한다.\n②본부사령실에 필요한 부서와 부대를 둘 수 있다.\n③제2항의 부서의 설치와 업무분장에 관한 사항은 참모총장이, 부대의 설치ㆍ임무와 조직에 관한 사항은 국방부장관이 정한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0022"
      },
      {
        "article_no": "제23조",
        "article_title": "처와 과의 설치",
        "chapter": "",
        "content": "제23조 (처와 과의 설치)\n①일반참모부에는 처 및 과를 두고, 특별참모부에는 과 또는 담당관을 둔다.\n②제1항의 처ㆍ과 및 담당관의 설치와 업무분장에 관한 사항은 참모총장이 정한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0023"
      },
      {
        "article_no": "제24조",
        "article_title": "위원회 등",
        "chapter": "",
        "content": "제24조 (위원회 등)\n①육군본부에 참모총장의 자문에 응하기 위하여 필요한 위원회와 시험목적의 잠정기구를 둘 수 있다.\n②제1항의 위원회 및 시험목적의 잠정기구의 설치와 운영에 관한사항은 참모총장이 정한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0024"
      },
      {
        "article_no": "제25조",
        "article_title": "정원",
        "chapter": "",
        "content": "제25조 (정원) 육군본부에 두는 군인 및 군무원의 정원은 국방부장관이 정한다.",
        "enforcement_date": "19901001",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0025"
      }
    ]
  },
