      },
      {
        "article_no": "제26조",
        "article_title": "통신감",
        "chapter": "",
        "content": "제26조 (통신감) 통신감은 통신ㆍ전자에 관한 계획, 통신ㆍ전자체제의 연구ㆍ발전 기타 통신ㆍ전자에 관한 사항을 분장한다.",
        "enforcement_date": "19820529",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0026"
      },
      {
        "article_no": "제27조",
        "article_title": "",
        "chapter": "",
        "content": "제27조 삭제<1982ㆍ5ㆍ29>",
        "enforcement_date": "19820529",
        "relations": [],
        "images": [],
        "provision_id": "law:육군본부직제#JO0027"
      },
      {
        "article_no": "제28조",
        "article_title": "",
        "chapter": "",
        "content": "제28조 삭제<1970ㆍ12ㆍ31>",
        "enforcement_date": "19820529",
