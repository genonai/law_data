      {
        "article_no": "제6조",
        "article_title": "등록사항과 면허장의 정정",
        "chapter": "",
        "content": "제6조 (등록사항과 면허장의 정정) 해기사는 본적 또는 성명을 변경하거나 면허장의 기재사항의 오기를 발견한 때에는 지체없이 교통부령으로 정하는 서식에 의한 신청서에 호적초본 기타 이를 증명하는 서류와 면허장을 첨부하여 면허장을 교부한 교통부장관 또는 지방해운관청에 정정을 신청하여 그의 정정을 받아야 한다.",
        "enforcement_date": "19730828",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행령#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "면허장의 재교부",
        "chapter": "",
        "content": "제7조 (면허장의 재교부) 해기사가 면허장을 멸실 또는 훼손한 때에는 교통부령이 정하는 바에 따라 지체없이 재교부받아야 한다.",
        "enforcement_date": "19730828",
        "relations": [],
        "images": [],
