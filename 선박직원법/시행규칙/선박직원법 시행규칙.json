    "article_count": 19,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 영은 선박직원법(이하 \"법\"이라 한다) 및 선박직원법시행령(이하 \"영\"이라 한다)의 시행에 관하여 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "면허신청서의 서식",
        "chapter": "",
        "content": "제2조(면허신청서의 서식)\n①영 제2조의 규정에 의한 해기사면허신청서는 별지 제1호서식에 의한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "면허장의 서식",
        "chapter": "",
        "content": "제3조(면허장의 서식) 영 제3조의 규정에 의한 해기사면허장의 서식은 별지 제2호서식에 의한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "면허의 신청기간",
        "chapter": "",
        "content": "제4조(면허의 신청기간) 법 제6조제3항의 규정에 의한 시험에 합격한 자의 면허교부신청기간은 시험합격자 발표일로부터 1년으로 한다. 다만, 승무경력을 갖추기 전에 시험에 합격한 자는 영 제19조제2항의 규정에 의하여 승무경력을 갖춘 날로부터 1년으로 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "면허장 정정 신청서",
        "chapter": "",
        "content": "제5조(면허장 정정 신청서) 영 제6조의 규정에 의한 면허장 정정 신청서는 별지 제3호서식에 의한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "면허장재교부 신청서",
        "chapter": "",
        "content": "제6조(면허장재교부 신청서) 영 제7조의 규정에 의한 면허장의 재교부 신청은 별지 제4호서식에 의한 신청서에, 훼손의 경우에는 그 면허장을, 멸실의 경우에는 그 사실을 증명하는 서류를 첨부하여 면허장을 교부한 교통부장관 또는 지방해운관청(부산항만관리청 및 지방해운국장을 말한다. 이하 같다)에 면허장의 재교부를 신청하여야 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "해기사의 실태보고",
        "chapter": "",
        "content": "제7조(해기사의 실태보고) 교통부장관은 법 제9조의2의제2항의 규정에 의한 해기사의 취업실태를 신고받고자 할 때에는 신고를 받는 목적, 신고장소, 신고기간, 신고내용 기타 필요한 사항을 공고하여야 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "시험의 신청",
        "chapter": "",
        "content": "제8조(시험의 신청) 영 제15조의 규정에 의한 시험에 응시하고자 하는 자는 별지 제5호서식에 의한 해기사 국가시험 신청서에 다음의 서류를 첨부하여 교통부장관 또는 지방해운관청에 제출하여야 한다.\n1.  승무경력을 증명하는 서류\n2.  제15조의 규정에 의한 신체검사합격을 증명하는 서류\n3.  해기사면허장 또는 무선통신사자격증을 소지한 자는 그 자격증사본\n4.  영 제19조제1항제1호의 규정에 의한 학교 졸업자는 그 졸업을 증명하는 서류\n5.  영 제19조제1항제2호의 규정에 의한 해기사 양성기관 졸업자는 그 졸업을 증명하는 서류\n6.  영 제30조의 규정에 의하여 필기시험을 면제받고자 하는 자는 그 사실을 증명하는 서류",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "시험의 시기",
        "chapter": "",
        "content": "제9조(시험의 시기) 영 제16조제2항의 규정에 의한 정기시험은 각각 3월, 6월, 9월 및 12월에 시행한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "해기사 양성기관의 지정신청",
        "chapter": "",
        "content": "제10조(해기사 양성기관의 지정신청) 영 제19조제4항의 규정에 의하여 해기사 양성기관으로 지정을 받고자 하는 자는 별지 제6호서식에 의한 신청서에 다음 각호의 서류를 첨부하여 교통부장관에게 제출하여야 한다.\n1.  운영계획서\n가.  운영의 개요\n나.  소요자금의 총액\n2.  시설기준에 관한 서류\n3.  과정별 정원표\n4.  강사(시간강사를 포함한다)의 명단 및 이력서\n5.  교육과정별 시간수 및 교육내용을 기재한 서류",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "해기사 양성기관의 지정",
        "chapter": "",
        "content": "제11조(해기사 양성기관의 지정) 교통부장관이 해기사 양성기관을 지정한 때에는 별지 제7호서식에 의한 해기사 양성기관 지정서를 교부하여야 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "해기사 양성기관의 명칭등 변경신고",
        "chapter": "",
        "content": "제12조(해기사 양성기관의 명칭등 변경신고) 해기사 양성기관의 명칭, 대표자 또는 소재지등이 변경된 때에는 그 사유가 발생한 날로부터 1월이내에 교통부장관에게 신고하여야 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "교과편성",
        "chapter": "",
        "content": "제13조(교과편성)\n①제11조의 규정에 의하여 지정된 해기사 양성기관은 별표 1의 교과편성기준에 따라 교과를 편성하여야 한다.\n②교육은 1교시를 50분으로 하여 주 39교시로 실시한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "지정의 취소",
        "chapter": "",
        "content": "제14조(지정의 취소) 교통부장관은 해기사 양성기관이 다음 각호의1에 해당하는 사유가 생긴 때에는 그 지정을 취소할 수 있다.\n1.  제12조의 규정에 위반된 때\n2.  교육실적 또는 교육방법이 현저히 불량한 때\n3.  허위 기타 부정한 방법으로 지정을 받은 때",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0014"
      },
      {
        "article_no": "제15조",
        "article_title": "신체검사",
        "chapter": "",
        "content": "제15조(신체검사) 영 제28조제1항의 규정에 의한 신체검사는 별표 2의 검사항목란에 게기하는 항목별로 행하고, 그 합격기준은 동표의 합격기준에 의한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "합격통지등",
        "chapter": "",
        "content": "제16조(합격통지등)\n①교통부장관 또는 지방해운관청은 시험 또는 필기시험에 합격한 자에 대하여는 당해합격통지서를 교부한다. 다만, 교부하기 곤란할 때에는 공고로써 이에 갈음할 수 있다.\n②필기시험에 합격한 자나 신체검사에 합격한 자는 교통부장관 또는 지방해운관청에서 그 합격증명서의 교부를 신청할 수 있다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0016"
      },
      {
        "article_no": "제17조",
        "article_title": "선박직원의 예외지정",
        "chapter": "",
        "content": "제17조(선박직원의 예외지정) 법 제15조제1항제4호의 규정에 의한 \"기타 교통부령이 정하는 경우\"라 함은 항해의 조건등을 감안하여 당해선박에 영 제32조에 규정된 승무자격을 가진 선박직원을 승무시킬 필요가 없다고 교통부장관이 인정하는 경우를 말한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0017"
      },
      {
        "article_no": "제18조",
        "article_title": "선박직원승무자격경감등 승인신청 서식",
        "chapter": "",
        "content": "제18조(선박직원승무자격경감등 승인신청 서식) 영 제34조제1항의 규정에 의한 승인신청서의 서식은 별지 제8호서식에 의한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0018"
      },
      {
        "article_no": "제19조",
        "article_title": "수수료",
        "chapter": "",
        "content": "제19조(수수료) 영 제2조의 규정에 의한 면허의 신청, 영 제6조의 규정에 의한 등록사항과 면허장의 정정신청, 영 제7조의 규정에 의한 면허장의 재교부신청, 제8조의 규정에 의한 시험신청 또는 제16조제2항의 규정에 의한 합격증명서 교부신청을 하고자 할 때에는 별표 3에 의한 수수료를 수입인지로 납입하여야 한다.",
        "enforcement_date": "19731006",
        "relations": [],
        "images": [],
        "provision_id": "law:선박직원법시행규칙#JO0019"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "19731006",
      "promulgation_no": "00457",
      "addendum_key": "1973100600457",
      "content": "부칙 <제457호,1973.10.6>\n①(시행일) 이 영은 공포한 날로부터 시행한다.\n②(경과규정) 이 영은 시행당시의 해기원양성기관은 이영에 의한 해기사 양성기관으로 한다.\n③(폐지법령) 교통부령 제218호 선박직원법 제15조제4호의 규정에 의한 선박직원의 자격지정에 관한 규칙은 이 영 시행과 동시에 이를 폐지한다."
    }
  ],
