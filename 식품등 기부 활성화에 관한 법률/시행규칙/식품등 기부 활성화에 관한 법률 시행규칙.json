                                  ┃\n┃                                                                ┃\n┃                                                                ┃\n┃                                                                ┃\n┃                                                                ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n210㎜×297㎜(보존용지(1종) 120g/㎡)\n\n\n(뒤쪽)\n┏━━━━━━━━━━━━━━━━━━━┓\n┃변경내용                              ┃\n┠───┬───┬───────────┨\n┃연월일│내  용│작 성 자              ┃\n┃      │      ├──┬──┬─────┨\n┃      │      │직급│성명│서명 또는 ┃\n┃      │      │    │    │인        ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┠───┼───┼──┼──┼─────┨\n┃      │      │    │    │          ┃\n┗━━━┷━━━┷━━┷━━┷━━━━━┛\n\n■ 식품등 기부 활성화에 관한 법률 시행규칙 [별지 제3호서식]\n\n철회ㆍ폐업 신고서\n─────────┬──────┬────────┬───────────────────\n접수번호        │접수일      │처리일          │처리기간                    즉시\n─────────┴──────┴────────┴───────────────────\n\n────┬───────────────────┬────────────────────\n신고인│성명(대표자)                          │생년월일\n├───────────────────┴────────────────────\n│주소\n│\n━━━━┷━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n━━