      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 법은 주거용건물의 임대차에 관하여 민법에 대한 특례를 규정함으로써 국민의 주거생활의 안정을 보장함을 목적으로 한다.",
        "enforcement_date": "19810305",
        "relations": [],
        "images": [],
        "provision_id": "law:주택임대차보호법#JO0001"
