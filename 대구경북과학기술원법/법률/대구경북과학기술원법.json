            "link_text": "대통령령",
            "line_text": "대통령령으로 정하는 바에 따라 연구계획서와고",
            "target_law_name": "대구경북과학기술원법 시행령",
            "target_article_no": "제16조",
            "target_article_title": "연구계획서 및 연구보고서 등의 제출",
