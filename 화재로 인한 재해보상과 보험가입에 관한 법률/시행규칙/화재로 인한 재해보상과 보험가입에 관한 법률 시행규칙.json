    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 영은 화재로인한재해보상과보험가입에관한법률의 시행에 관하여 필요한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "19730606",
        "relations": [],
        "images": [],
        "provision_id": "law:화재로인한재해보상과보험가입에관한법률시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "실손해액",
        "chapter": "",
        "content": "제2조 (실손해액) 화재로인한재해보상과보험가입에관한법률시행령(이하 \"영\"이라 한다) 제5조제2항의 규정에 의한 실손해액은 화재로 인하여 신체상에 상해를 입은 경우에 그 상해를 치료함에 소요되는 모든 비용으로 한다.",
        "enforcement_date": "19730606",
        "relations": [],
        "images": [],
        "provision_id": "law:화재로인한재해보상과보험가입에관한법률시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "화재보험료 산출방법",
        "chapter": "",
        "content": "제3조 (화재보험료 산출방법) 영 제10조제2항의 규정에 의한 화재보험료는 일반화재보험의 원수보혐료와 장기화재보험 및 가계종합보험의 원수보혐료중 화재위험보험료로 한다.",
        "enforcement_date": "19730606",
        "relations": [],
        "images": [],
        "provision_id": "law:화재로인한재해보상과보험가입에관한법률시행규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "출연시기",
        "chapter": "",
        "content": "제4조 (출연시기) 영 제10조제2항의 규정에 의한 협회비는 매월 당월분을 익익월말일까지 출연하여야 한다.",
        "enforcement_date": "19730606",
