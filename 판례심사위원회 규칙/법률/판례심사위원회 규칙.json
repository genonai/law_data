      "content": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n[별지 제4호서식] <개정 1995.8.21>\n\n┏━━━━━┯━━━━━━━━━┱───────━━━━\n┃의안번호  │제       호       ┃\n┠─────┼─────────┨              ──━━\n┃상정연월일│     년   월   일 ┃\n┠─────┼─────────┨              ┏━┱─\n┃의결연월일│     년   월   일 ┃              ┃의┃\n┠─────┼─────────┨              ┃  ┃\n┃기타      │                  ┃              ┃결┃\n┗━━━━━┷━━━━━━━━━┛              ┃  ┃\n┃사┃\n━━━━━━━━━━━━━━━━━              ┃  ┃\n┃항┃\n━━━━━━━━━━━━━━━━━              ┗━┛\n\n━━━━━━━━━━━━━━━━━\n\n─────────────────\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃                                                    ┃\n┃                                                    ┃\n┃                                                    ┃\n┃                                                    ┃\n┃                                                    ┃\n┃                                                    ┃\n┃                                                    ┃\n┃                                                    ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n\n━━━━━━━━━━━━━━━━━┏━━━━━┯━━━┓\n┃소관과    │편찬과┃\n━━━━━━━━━━━━━━━━━┠─────┼───┨\n┃제출연월일│      ┃\n─────────────────┗━━━━━┷━━━┛",
