  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 판례심사위원회는 대법원 판례집에 게재할 판례를 심사결정함을 목적으로 한다.",
        "enforcement_date": "19700925",
        "relations": [],
        "images": [],
        "provision_id": "law:판례심사위원회규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "설치",
        "chapter": "",
        "content": "제2조 (설치) 판례심사위원회는 대법원에 둔다.",
        "enforcement_date": "19700925",
        "relations": [],
        "images": [],
        "provision_id": "law:판례심사위원회규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구성",
        "chapter": "",
        "content": "제3조 (구성)\n①판례심사위원회는 위원장 1인 위원 15인 및 상임위원 1인으로 한다.\n②판례심사위원회에 간사 약간인을 둔다.",
        "enforcement_date": "19700925",
        "relations": [],
        "images": [],
        "provision_id": "law:판례심사위원회규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위와 같다",
        "chapter": "",
        "content": "제4조 (위와 같다) 위원장은 대법원장이, 위원은 대법원 판사가, 간사는 재판연구원이 각각 되며 상임위원은 법원행정처장 또는 차장중에서 위원장이 위촉한다.",
        "enforcement_date": "19700925",
        "relations": [],
        "images": [],
        "provision_id": "law:판례심사위원회규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수당",
        "chapter": "",
        "content": "제5조 (수당) 위원, 상임위원 및 간사에게는 예산의 범위안에서 위원장이 정하는 바에 의하여 수당을 지급할 수 있다.",
        "enforcement_date": "19700925",
        "relations": [],
        "images": [],
        "provision_id": "law:판례심사위원회규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "운영",
        "chapter": "",
        "content": "제6조 (운영) 기타 운영에 관한 중요한 사항은 위원회의 결의로써 정한다.",
        "enforcement_date": "19700925",
        "relations": [],
        "images": [],
        "provision_id": "law:판례심사위원회규칙#JO0006"
      }
    ]
  },
