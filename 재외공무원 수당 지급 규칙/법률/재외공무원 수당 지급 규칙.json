  "body": {
    "format": "articles",
    "article_count": 4,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규칙은 공무원수당규정(이하 \"영\"이라 한다)의 규정에 의하여 재외공무원에게 주택수당ㆍ특수지근무수당 및 재외근무수당을 지급하기 위하여 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "19830714",
        "relations": [],
        "images": [],
        "provision_id": "law:재외공무원수당지급규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "주택수당",
        "chapter": "",
        "content": "제2조 (주택수당) 영 제11조의2의 규정에 의한 재외공무원의 주택수당은 별표 1과 같다.",
        "enforcement_date": "19830714",
        "relations": [],
        "images": [],
        "provision_id": "law:재외공무원수당지급규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "특수지 근무수당",
        "chapter": "",
        "content": "제3조 (특수지 근무수당) 영 제12조제3항의 규정에 의한 재외공무원의 특수지 근무수당의 지급대상지역과 그 지역별 구분은 별표 2와 같다.",
        "enforcement_date": "19830714",
        "relations": [],
        "images": [],
        "provision_id": "law:재외공무원수당지급규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "재외근무수당",
        "chapter": "",
        "content": "제4조 (재외근무수당) 영 제14조의 규정에 의한 재외공무원의 재외근무수당의 지급대상지역별 구분은 별표 3과 같다.",
        "enforcement_date": "19830714",
        "relations": [],
        "images": [],
        "provision_id": "law:재외공무원수당지급규칙#JO0004"
      }
    ]
  },
