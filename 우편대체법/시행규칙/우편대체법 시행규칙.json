      {
        "article_no": "제44조",
        "article_title": "수수료",
        "chapter": "제4장 수수료",
        "content": "제44조 (수수료) 우편대체이용에 관한 수수료는 별표와 같다.",
        "enforcement_date": "19791022",
        "relations": [],
        "images": [],
        "provision_id": "law:우편대체법시행규칙#JO0044"
