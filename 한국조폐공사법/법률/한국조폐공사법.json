      {
        "article_no": "제1조",
        "article_title": "",
        "chapter": "제1장 총칙",
        "content": "제1조 한국조폐공사는 화폐, 은행권, 국채, 복표, 수입인지기타증권과 그 용지 및 정부가 지정한 목적에 사용할 특수용지을 제조함을 목적으로 한다.<개정 1955ㆍ11ㆍ15>",
        "enforcement_date": "19730305",
        "relations": [],
        "images": [],
        "provision_id": "law:한국조폐공사법#JO0001"
      },
