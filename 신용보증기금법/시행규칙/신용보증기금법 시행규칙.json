  "body": {
    "format": "articles",
    "article_count": 3,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "대출금의 범위",
        "chapter": "",
        "content": "제1조 (대출금의 범위) 신용보증기금법(이하\"법\"이라 한다) 제6조제2항의 규정에 의한 금융기관의 대출금의 범위는 별표와 같다. 다만, 당해대출금중 통상이자율 미만의 특별이자율을 적용하는 대출금은 제외한다.",
        "enforcement_date": "19750301",
        "relations": [],
        "images": [],
        "provision_id": "law:신용보증기금법시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "출연의 방법",
        "chapter": "",
        "content": "제2조 (출연의 방법) 금융기관은 법 제6조제2항의 규정에 의하여 매월 말일 현재로 제1조의 대출금의 월중 평균잔액의 연율 1,000분의5에 해당하는 금액을 신용보증기금(이하\"기금\"이라 한다)에 출연하여야 한다. 다만, 국민은행이 취급하는 상호부금급부금의 경우에는 매월 말일 현재의 월중 이자수입액(연체 과태금을 제외한다)을 당해상호부금급부금이자율(최초의 이자율로 한다)로 나눈 금액에 연율 1,000분의5를 곱하여 얻은 금액을 출연하여야 한다.",
        "enforcement_date": "19750301",
        "relations": [],
        "images": [],
        "provision_id": "law:신용보증기금법시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "출연의 시기",
        "chapter": "",
        "content": "제3조 (출연의 시기) 금융기관은 제2조의 규정에 의한 매월분의 출연금을 다음달 말일까지 기금에 출연하여야 한다.",
        "enforcement_date": "19750301",
        "relations": [],
        "images": [],
        "provision_id": "law:신용보증기금법시행규칙#JO0003"
      }
    ]
  },
