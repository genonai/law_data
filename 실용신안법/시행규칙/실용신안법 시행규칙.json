    "articles": [
      {
        "article_no": "제1조",
        "article_title": "출원서등",
        "chapter": "",
        "content": "제1조 (출원서등) 실용신안법(이하 \"법\"이라 한다) 제12조의 규정에 의한 실용신안등록출원서 ㆍ명세서 및 도면의 서식은 각각 특허법시행규칙 제31조에서 정하는 특허출원서 ㆍ명세서 및 도면의 서식에 준한다.",
        "enforcement_date": "19740101",
        "relations": [],
        "images": [],
        "provision_id": "law:실용신안법시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "출원변경",
        "chapter": "",
        "content": "제2조 (출원변경) 법 제9조의 규정에 의하여 특허의 출원 또는 의장등록의 출원을 실용신안등록의 출원으로 변경하고자 하는 자는 특허법시행규칙 제38조에서 정하는 특허출원서의 서식에 준한 실용신안등록출원서를 따로 제출하여야 한다",
        "enforcement_date": "19740101",
        "relations": [],
        "images": [],
        "provision_id": "law:실용신안법시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "심판청구서",
        "chapter": "",
        "content": "제3조 (심판청구서) 법 제16조의 규정에 의한 통상실시권허여의 심판청구서의 서식 및 법 제25조의 규정에 의한 심판청구서의 서식은 각각 특허법시행규칙 제53조에서 정하는 통상실시권허여의 심판청구서 및 심판청구서의 서식에 준한다.",
        "enforcement_date": "19740101",
        "relations": [
          {
            "relation_type": "delegation",
            "delegation_type": "위임행정규칙",
            "target_category": "행정규칙",
            "source_article_no": "제3조",
            "source_clause": "제3조제5항",
            "link_text": "지식재산처장이 정하여 고시하는",
            "line_text": "전자문서로 제출하기 위해서는 지식재산처장이 정하여 고시하는 파일 형식을 따라야 한다",
            "target_law_name": "전자문서 제출 파일의 형식 및 재전자화에 관한 고시",
            "target_article_no": "",
