            "source_clause": "제2조제1항",
            "link_text": "대법원규칙",
            "line_text": "대법원규칙으로 정하는",
            "target_law_name": "소액사건심판규칙",
            "target_article_no": "제1조의2",
            "target_article_title": "소액사건의 범위",
            "target_mst": "187995",
            "target_url": "https://www.law.go.kr/법령/소액사건심판규칙/제1조의2",
