  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규칙은 헌법재판소법 제16조제5항에 의하여 재판관회의 운영에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "소집",
        "chapter": "",
        "content": "제2조 (소집) 재판관회의는 정례재판관회의와 임시재판관회의로 구분하되 정례재판관회의는 매월 첫째주 월요일에 소집하고, 임시재판관회의는 필요에 따라 헌법재판소장 또는 헌법재판소 재판관(이하 \"헌법재판관\"이라 한다) 3인이상의 요구에 의하여 헌법재판소장이 소집한다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "의장",
        "chapter": "",
        "content": "제3조 (의장) 헌법재판소장은 재판관회의 의장이 되며, 회의를 주재하고 의결된 사항을 집행한다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "의안배포",
        "chapter": "",
        "content": "제4조 (의안배포) 의안은 보고안건과 의결안건으로 구분하여 사무처장이 제1호서식에 의하여 재판관회의 전일까지 의사일정표와 함께 각 헌법재판관에게 배포한다. 다만, 긴급한 사항에 대하여는 그러하지 아니하다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "서면의결",
        "chapter": "",
        "content": "제5조 (서면의결) 보고사항이나 의결사항으로서 경미한 사항은 서면으로 의결할 수 있다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "비밀안건",
        "chapter": "",
        "content": "제6조 (비밀안건) \"비밀\" 표시의 안건에 대하여는 헌법재판소장의 승인없이 이를 발표하지 못한다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "간사",
        "chapter": "",
        "content": "제7조 (간사) 재판관회의의 간사는 사무처공무원중에서 헌법재판소장이 지명한다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "회의록",
        "chapter": "",
        "content": "제8조 (회의록)\n①간사는 재판관회의록(제5조의 규정에 의한 서면 의결을 한 때에는 재판관회의 결의록)을 작성하고 서명날인한다.\n②헌법재판소장은 제1항에 의하여 작성된 회의록 또는 결의록을 확인하고 서명날인한다.\n③제1항에 의한 회의록과 결의록은 별지 제2호 및 제3호서식에 따른다.",
        "enforcement_date": "19880924",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소재판관회의규칙#JO0008"
      }
    ]
  },
