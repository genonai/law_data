  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규칙은 업무를 성실히 수행하여 헌법재판소 발전에 기여한 공로가 크고 타의 모범이 되는 헌법재판소공무원(이하 \"모범공무원\"이라 한다)의 선발과 상여수당지급등에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "19890318",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소모범공무원규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "추천",
        "chapter": "",
        "content": "제2조 (추천)\n①모범공무원의 추천은 헌법재판소 사무처장이 이를 행한다.\n②모범공무원은 6급이하 헌법재판소공무원 중에서 선발하며 대상자의 행적ㆍ직무내용ㆍ근무조건 및 기타사항을 참작하여야 한다.",
        "enforcement_date": "19890318",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소모범공무원규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "선발",
        "chapter": "",
        "content": "제3조 (선발)\n①모범공무원의 선발은 헌법재판소 공적심사위원회의 심사ㆍ의결을 거쳐 헌법재판소장이 이를 행한다.\n②모범공무원으로 이미 선발된 사실이 있는 자는 다시 모범공무원으로 선발할 수 없다.",
        "enforcement_date": "19890318",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소모범공무원규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "증표의 수여",
        "chapter": "",
        "content": "제4조 (증표의 수여) 모범공무원으로 선발된 자에 대하여는 그 증표로써 별지의 모범공무원증을 수여한다.",
        "enforcement_date": "19890318",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소모범공무원규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "가산점 부여",
        "chapter": "",
        "content": "제5조 (가산점 부여) 모범공무원으로 선발된 자에 대하여는 별표에서 정하는 바에 따라 가산점을 부여한다.",
        "enforcement_date": "19890318",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소모범공무원규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "상여수당지급",
        "chapter": "",
        "content": "제6조 (상여수당지급) 모범공무원으로 선발된 자에 대하여는 헌법재판소공무원수당규칙이 정하는 바에 의하여 상여수당을 지급한다.",
        "enforcement_date": "19890318",
        "relations": [],
        "images": [],
        "provision_id": "law:헌법재판소모범공무원규칙#JO0006"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "19890318",
      "promulgation_no": "00017",
      "addendum_key": "1989031800017",
      "content": "부칙 <제17호,1989.3.18>\n1. (시행일) 이 규칙은 공포한 날로부터 시행한다.\n2. (경과조치) 국회모범공무원규정, 정부의 모범공무원규정 또는 법원의 우수공무원상여금지급규칙에 의하여 모범공무원 또는 우수공무원으로 선발된 헌법재판소 공무원은 이 규칙에 의하여 모범공무원으로 선발된 것으로 본다."
    }
  ],
