  "addenda": [
    {
      "promulgation_date": "19720310",
      "promulgation_no": "00223",
      "addendum_key": "1972031000223",
      "content": "부칙 <제223호,1972.3.10>\n이 영은 공포한 날로부터 시행한다."
    },
    {
      "promulgation_date": "19750808",
      "promulgation_no": "00277",
      "addendum_key": "1975080800277",
      "content": "부칙 <제277호,1975.8.8>\n이 규칙은 1975년 9월 1일부터 시행한다."
    },
    {
      "promulgation_date": "19800903",
      "promulgation_no": "00328",
      "addendum_key": "1980090300328",
      "content": "부칙 <제328호,1980.9.3>\n이 규칙은 공포한 날로부터 시행한다."
    },
    {
      "promulgation_date": "19810210",
      "promulgation_no": "00333",
      "addendum_key": "1981021000333",
      "content": "부칙 <제333호,1981.2.10>\n이 규칙은 1981년 3월 1일부터 시행한다."
    },
    {
      "promulgation_date": "19851210",
      "promulgation_no": "00375",
      "addendum_key": "1985121000375",
      "content": "부칙 <제375호,1985.12.10>\n이 규칙은 공포한 날로부터 시행하되, 제4조의 개정규정은 1986년 3월 1일부터, 제5조의 개정규정은 1986년 1월 1일부터 각각 적용한다."
    },
    {
      "promulgation_date": "19890727",
      "promulgation_no": "00403",
      "addendum_key": "1989072700403",
      "content": "부칙 <제403호,1989.7.27>\n①(시행일) 이 규칙은 공포한 날부터 시행한다.\n②(일반군사교육이수자의 복무기간단축처리절차에 관한 경과조치) 이 규칙 시행당시 학생일반군사교육과정을 이수한 자에 대한 군복무기간의 단축처리절차에 관하여는 종전의 규정에 의한다.\n③(서식계속사용에 관한 경과조치) 이 규칙 시행으로 삭제되는 종전의 별지 제2호서식 내지 별지 제4호서식은 부칙 제2항의 경우에 이를 계속 사용한다."
    },
    {
      "promulgation_date": "20070622",
      "promulgation_no": "00629",
      "addendum_key": "2007062200629",
      "content": "부칙 <제908호,2007.6.22>\n이 규칙은 공포한 날부터 시행한다."
    },
    {
      "promulgation_date": "20080304",
      "promulgation_no": "00646",
      "addendum_key": "2008030400646",
      "content": "부칙(국방부와 그 소속기관 직제 시행규칙) <제646호,2008.3.4>\n제1조(시행일) 이 규칙은 공포한 날부터 시행한다.\n제2조 생략\n제3조(다른 법령의 개정) ① 부터 ⑨ 까지 생략\n⑩ 학생군사교육실시령 시행규칙 일부를 다음과 같이 개정한다.\n제9조제1항, 제10조제2항 및 제11조 중 \"교육인적자원부장관\"을 각각 \"교육과학기술부장관\"으로 한다.\n⑪ 생략"
    },
    {
      "promulgation_date": "20081209",
      "promulgation_no": "00658",
      "addendum_key": "2008120900658",
      "content": "부칙 <제658호,2008.12.9>\n이 규칙은 공포한 날부터 시행한다."
    },
    {
      "promulgation_date": "20121210",
      "promulgation_no": "00784",
      "addendum_key": "2012121000784",
      "content": "부칙(법령서식 개선을 위한 국방부 및 그 소속청 소관 비영리법인의 설립 및 감독에 관한 규칙 등 일부개정령) <제784호,2012.12.10>\n이 규칙은 공포한 날부터 시행한다."
    },
    {
      "promulgation_date": "20130323",
      "promulgation_no": "00793",
      "addendum_key": "2013032300793",
      "content": "부칙(국방부와 그 소속기관 직제 시행규칙) <제793호,2013.3.23>\n제1조(시행일) 이 규칙은 공포한 날부터 시행한다.\n제2조 생략\n제3조(다른 법령의 개정) ①부터 ⑧까지 생략\n⑨ 학생군사교육실시령 시행규칙 일부를 다음과 같이 개정한다.\n제9조제1항, 제10조제2항 및 제11조 중 \"교육과학기술부장관\"을 각각 \"교육부장관\"으로 한다.\n⑩ 생략"
    },
    {
      "promulgation_date": "20150722",
      "promulgation_no": "00864",
      "addendum_key": "2015072200864",
      "content": "부칙 <제864호,2015.7.22>\n이 규칙은 공포한 날부터 시행한다."
    },
    {
      "promulgation_date": "20161129",
      "promulgation_no": "00907",
      "addendum_key": "2016112900907",
      "content": "부칙(병역법 시행규칙) <제907호,2016.11.29>\n제1조(시행일) 이 규칙은 2016년 11월 30일부터 시행한다.\n제2조(다른 법령의 개정) ①부터 ⑩까지 생략\n⑪ 학생군사교육실시령 시행규칙 일부를 다음과 같이 개정한다.\n제2조제1호 및 제2호 중 \"학군무관후보생과정\"을 각각 \"학군 군간부후보생과정\"으로 한다.\n제3조 중 \"학군무관후보생군사교육\"을 \"학군 군간부후보생군사교육\"으로 한다.\n제7조제1항 각 호 외의 부분 중 \"학군무관후보생과정\"을 \"학군 군간부후보생과정\"으로 한다.\n제9조제1항 중 \"학군무관후보생과정\"을 \"학군 군간부후보생과정\"으로 한다."
    }
  ],
