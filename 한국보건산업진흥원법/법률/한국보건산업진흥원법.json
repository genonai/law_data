    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 법은 한국보건산업진흥원을 설립하여 보건산업의 육성ㆍ발전과 보건서비스의 향상을 위한 지원사업을 전문적ㆍ체계적으로 수행함으로써 보건산업의 국제경쟁력을 높이고 국민보건향상에 이바지함을 목적으로 한다.",
        "enforcement_date": "19990121",
        "relations": [],
        "images": [],
        "provision_id": "law:한국보건산업진흥원법#JO0001"
      },
      {
