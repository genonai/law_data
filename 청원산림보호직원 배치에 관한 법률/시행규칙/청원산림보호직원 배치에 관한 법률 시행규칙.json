    "articles": [
      {
        "article_no": "제1조",
        "article_title": "보호직원의 배치신청서",
        "chapter": "",
        "content": "제1조 (보호직원의 배치신청서) 청원산림보호직원배치에 관한 법률 시행령(이하 \"영\"이라 한다) 제1조제1항의 규정에 의한 청원산림보호직원의 배치신청서는 별지 제1호서식에 의한다.",
        "enforcement_date": "19701001",
        "relations": [],
        "images": [],
        "provision_id": "law:청원산림보호직원배치에관한법률시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "보호직원의 배치통지서",
        "chapter": "",
        "content": "제2조 (보호직원의 배치통지서) 영 제1조제3항의 규정에 의한 청원산림보호직원의 배치통지서는 별지 제2호서식에 의한다.",
        "enforcement_date": "19701001",
        "relations": [],
        "images": [],
        "provision_id": "law:청원산림보호직원배치에관한법률시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "경비의 납입",
        "chapter": "",
        "content": "제3조 (경비의 납입) 영 제2조제1항의 경비는 청원산림보호직원의 배치통지서를 받은 날로부터 30일이내에 납입하여야 하며, 그 배치통지서를 받은 다음 연도 이후의 경비는 영 제2조제2항의 고시가 있은 날로부터 30일이내에 납입하여야 한다.",
        "enforcement_date": "19701001",
        "relations": [],
        "images": [],
        "provision_id": "law:청원산림보호직원배치에관한법률시행규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "경비의 산정",
        "chapter": "",
        "content": "제4조 (경비의 산정) 산림청장은 영 제2조제2항의 규정에 의하여 경비의 납입기준액을 산정함에 있어서는 법 제3조의 2의 규정에 의한 경비보조액을 감안하여야 한다.",
        "enforcement_date": "19701001",
        "relations": [],
        "images": [],
        "provision_id": "law:청원산림보호직원배치에관한법률시행규칙#JO0004"
      }
    ]
  },
