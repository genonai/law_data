  │    │    │    ┃\n┃        │  │  │                                  │    │    │    │    │    │    │    │    │    │    │    │    │    │    │    ┃\n┃        │  │  │                                  │    │    │    │    │    │    │    │    │    │    │    │    │    │    │    ┃\n┃        │  │  │                                  │    │    │    │    │    │    │    │    │    │    │    │    │    │    │    ┃\n┗━━━━┷━┷━┷━━━━━━━━━━━━━━━━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┷━━┛\n(별지 2)\n[별표 1의 다]\n단순양허한 농림축산물 중 시장접근물량 설정물품에 대한 양허관세(제2조 및 제7조관련)\n┏━━━━━━━━┯━━━━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━┓\n┃품목번호        │품명                                │2005년                      │2006년                        │2007년                        │2008년                        │2009년                        │2010년                        │2011년                        │2012년                        │2013년                        │2014년                        ┃\n┃                │                                    ├─────┬────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┼─────┬─────────┨\n┃                │                                    │시장      │세율(%)         │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           │시장      │세율(%)           ┃\n┃                │                                    │접근      ├───┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┤접근      ├────┬────┨\n┃                │                                    │물량      │시장접│시장접근│물량      │시장접근│시장접근│물량      │시장접근│시장접근│물량      │시장접근│시장접근│물량     