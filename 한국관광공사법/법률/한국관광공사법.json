      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 법은 한국관광공사(이하 \"公社\"라 한다)를 설립하여 관광진흥, 관광자원개발, 관광산업의 연구개발 및 관광요원의 양성ㆍ훈련에 관한 사업을 수행하게 함으로써 국가경제발전과 국민복지증진에 이바지하게 함을 목적으로 한다.",
        "enforcement_date": "19980101",
        "relations": [],
        "images": [],
        "provision_id": "law:한국관광공사법#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "법인격",
        "chapter": "",
        "content": "제2조 (법인격) 공사는 법인으로 한다.",
        "enforcement_date": "19980101",
        "relations": [],
        "images": [],
        "provision_id": "law:한국관광공사법#JO0002"
