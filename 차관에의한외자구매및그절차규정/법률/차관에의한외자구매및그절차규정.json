  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 영은 외국정부나 국제기관의 차관(이하 \"차관\"이라 한다)에 의한 외자구매 및 그 절차를 규정함을 목적으로 한다.",
        "enforcement_date": "19700916",
        "relations": [],
        "images": [],
        "provision_id": "law:차관에의한외자구매및그절차규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조 (적용범위) 차관에 의하여 도입되는 외자의 구매 및 그 절차는 당해차관협정 및 다른 법령에 따로 규정이 없는 한 이 영이 정하는 바에 의한다.",
        "enforcement_date": "19700916",
        "relations": [],
        "images": [],
        "provision_id": "law:차관에의한외자구매및그절차규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구매절차",
        "chapter": "",
        "content": "제3조 (구매절차)\n①차관에 의한 외자의 구매는 차관을 획득한 자 또는 차관을 전대받은 자(이하 \"실수요자\"라 한다)가 정부기관 또는 정부관리기업체인 때에는 조달청을 구매기관으로 한다.\n②실수요자가 민간인인 때에는 그 실수요자의 선택에 따라 직접 또는 조달청을 통하여 외자를 구매할 수 있다.",
        "enforcement_date": "19700916",
        "relations": [],
        "images": [],
        "provision_id": "law:차관에의한외자구매및그절차규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "지불약정은행의 지정",
        "chapter": "",
        "content": "제4조 (지불약정은행의 지정) 차관협정이 지불약정은행의 지정에 관하여 수개의 은행중에서 그 하나를 선택할 수 있도록 규정된 때에는 실수요자는 한국은행과 협의하여 지불약정은행을 지정하여야 한다.",
        "enforcement_date": "19700916",
        "relations": [],
        "images": [],
        "provision_id": "law:차관에의한외자구매및그절차규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수입허가",
        "chapter": "",
        "content": "제5조 (수입허가) 실수요자가 차관에 의하여 외자를 구매하고자 할 때에는 무역거래법이 정하는 바에 의하여 상공부장관의 수입허가를 받아야 한다.",
        "enforcement_date": "19700916",
        "relations": [],
        "images": [],
        "provision_id": "law:차관에의한외자구매및그절차규정#JO0005"
      }
    ]
  },
