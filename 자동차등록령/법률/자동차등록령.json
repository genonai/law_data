    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조 (목적) 이 영은 도로운송차량법(이하\"법\"이라 한다)및 자동차저당법(이하 \"저당법\"이라 한다)에 의한 자동차의 등록에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "19750625",
        "relations": [],
        "images": [],
        "provision_id": "law:자동차등록령#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "제1장 총칙",
        "content": "제2조 (정의) 이 영에서 \"자동차\"라 함은 법에 의하여 등록된 자동차를 말한다.",
        "enforcement_date": "19750625",
