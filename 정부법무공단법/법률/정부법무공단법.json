    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 법은 정부법무공단을 설립하여 국가 등의 소송 그 밖의 법률사무를 지원하는 사업을 수행하게 함으로써 국가의 정당한 이익을 보호하고 행정의 합법성을 확보하여 국민을 위한 법치행정의 구현에 이바지함을 목적으로 한다.",
        "enforcement_date": "20171212",
        "relations": [],
        "images": [],
        "provision_id": "law:정부법무공단법#JO0001"
      },
