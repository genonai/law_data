    "articles": [
      {
        "article_no": "제1조",
        "article_title": "거래징수",
        "chapter": "",
        "content": "제1조 (거래징수) 증권거래세법시행령(이하 \"영\"이라 한다) 제6조에 규정하는 비과세양도명세서는 별지 제1호서식에 의한다.",
        "enforcement_date": "19790101",
        "relations": [],
        "images": [],
        "provision_id": "law:증권거래세법시행규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "증권거래세과세표준신고",
        "chapter": "",
        "content": "제2조 (증권거래세과세표준신고) 영 제7조제1항에 규정하는 증권거래세 과세표준신고서는 별지 제2호 갑ㆍ을서식에 의한다.",
        "enforcement_date": "19790101",
        "relations": [],
        "images": [],
        "provision_id": "law:증권거래세법시행규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "장부의 비치기장",
        "chapter": "",
        "content": "제3조 (장부의 비치기장)\n①영 제9조에 규정하는 주권등의 거래장부는 별지 제3호서식에 의한다. 다만, 증권거래세법 제3조제1호의 납세의무자는 거래원별, 양도금액, 증권거래세, 과세 및 비과세 구분을 기재한다.\n②제1항에 규정하는 서식에 의하지 아니한 경우에도 영 제9조에 규정하는 기재사항의 전부가 기재된 경우에는 법 제15조의 규정에 의한 기장으로 본다.",
        "enforcement_date": "19790101",
        "relations": [],
        "images": [],
        "provision_id": "law:증권거래세법시행규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "조사증",
        "chapter": "",
        "content": "제4조 (조사증) 영 제11조에 규정하는 증표는 별지 제4호서식에 의한다.",
        "enforcement_date": "19790101",
        "relations": [],
        "images": [],
        "provision_id": "law:증권거래세법시행규칙#JO0004"
      }
    ]
  },
