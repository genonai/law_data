      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 법은 한국도로공사(이하 \"公社\"라 한다)를 설립하여 유료도로의 설치와 관리를 행하게 함으로써 도로의 정비를 촉진하고 도로교통의 발달에 기여함을 목적으로 한다.",
        "enforcement_date": "19761231",
        "relations": [],
        "images": [],
        "provision_id": "law:한국도로공사법#JO0001"
      },
