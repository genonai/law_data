      {
        "article_no": "제17조",
        "article_title": "국유재산의 무상대부 등",
        "chapter": "",
        "content": "제17조(국유재산의 무상대부 등) 정부는 재단의 설립과 운영을 위하여 필요하면 국유재산을 재단에 무상으로 대부하거나 사용ㆍ수익하게 할 수 있다.",
        "enforcement_date": "20230328",
        "relations": [],
        "images": [],
        "provision_id": "law:한국국제교류재단법#JO0017"
      },
