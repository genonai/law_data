            "source_clause": "제7조제2항",
            "link_text": "정관으로 정하는",
            "line_text": "② 이사장, 정관으로 정하는 상근이사를 제외한 임원은 비상근으로 한다.",
            "target_law_name": "한국국제교류재단 정관",
            "target_article_no": "",
            "target_article_title": "",
